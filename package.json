{
  "name": "openchat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node --experimental-strip-types scripts/run-tool.ts npm install",
    "dev": "node --experimental-strip-types scripts/run-tool.ts tsx scripts/dev.ts",
    "dev:web": "node --experimental-strip-types scripts/run-tool.ts vite",
    "typecheck": "npm run typecheck:vue && npm run typecheck:node",
    "typecheck:vue": "node --experimental-strip-types scripts/run-tool.ts tsx scripts/typecheck-vue.ts --noEmit -p tsconfig.app.json",
    "typecheck:node": "node --experimental-strip-types scripts/run-tool.ts tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && node --experimental-strip-types scripts/run-tool.ts vite build && npm run build:electron",
    "build:electron": "node --experimental-strip-types scripts/run-tool.ts tsx scripts/build-electron.ts",
    "package:win": "npm run build && node --experimental-strip-types scripts/run-tool.ts tsx scripts/package-win.ts",
    "preview": "node --experimental-strip-types scripts/run-tool.ts vite preview",
    "start": "node --experimental-strip-types scripts/run-tool.ts electron .",
    "check": "npm run typecheck && npm run format:check",
    "test": "npm run check",
    "test:e2e": "npm run build && node --experimental-strip-types scripts/run-tool.ts playwright test",
    "format:check": "node --experimental-strip-types scripts/run-tool.ts prettier --check .",
    "format": "node --experimental-strip-types scripts/run-tool.ts prettier --write ."
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@imengyu/vue3-context-menu": "^1.5.6",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "^22.20.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "artplayer": "5.4.0",
    "deepfilternet3-noise-filter": "1.3.0",
    "diff-match-patch": "1.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.5.0",
    "element-plus": "^2.14.5",
    "image-size": "2.0.4",
    "jose": "^6.2.12",
    "livekit-client": "2.22.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-element-plus-x": "2.0.3",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-log": "^5.4.4",
    "ffmpeg-static": "5.3.0",
    "koffi": "3.3.2",
    "node-machine-id": "1.1.12",
    "onnxruntime-node": "1.30.0",
    "ppu-paddle-ocr": "6.6.1",
    "uiohook-napi": "1.5.5"
  },
  "build": {
    "appId": "com.openchat",
    "productName": "OpenChat",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/*.cjs",
      "package.json",
      "!public{,/**/*}",
      "!dist-electron/ocr-models{,/**/*}",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}{,/**/*}",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64{,/**/*}",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{darwin-*,linux*,win32-arm64}.node",
      "!node_modules/better-sqlite3-multiple-ciphers/{deps,src}{,/**/*}",
      "!node_modules/uiohook-napi/prebuilds/{darwin-*,linux-*,win32-arm64}{,/**/*}"
    ],
    "extraFiles": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**",
      "node_modules/ppu-paddle-ocr/**",
      "node_modules/ppu-ocv/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/@napi-rs/canvas*/**",
      "node_modules/@techstark/opencv-js/**",
      "dist-electron/image-ocr-worker.cjs",
      "node_modules/@koromix/**",
      "node_modules/better-sqlite3-multiple-ciphers/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "win": {
      "icon": "public/ico/openchat.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "openchat-${version}-setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/ico/openchat.ico",
      "uninstallerIcon": "public/ico/openchat.ico",
      "installerHeaderIcon": "public/ico/openchat.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@13.0.3": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "koffi@3.3.2": true,
    "uiohook-napi@1.5.5": true,
    "electron-winstaller@5.4.0": true
  }
}
